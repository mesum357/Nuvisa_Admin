generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPOINTMENT_BOOKED
  AT_EMBASSY
  APPROVED
  REJECTED
  COMPLETED
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(ADMIN)
  roleId    String?
  customRole AdminRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([email])
  @@index([isActive])
  @@map("admins")
}

/// Represents a custom admin role containing per-module permissions.
model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  // JSON object mapping module identifiers to permission objects, e.g.
  // { "applications": { "read": true, "write": false }, "users": { ... } }
  permissions Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admins      Admin[]

  @@map("admin_roles")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  name            String
  phone           String?
  status          UserStatus @default(PENDING_VERIFICATION)
  isVerified      Boolean    @default(false)
  verifiedAt      DateTime?
  emailVerified   Boolean    @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  applications Application[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([isVerified])
  @@map("users")
}

model Application {
  id              String            @id @default(uuid())
  userId          String
  applicationNo   String            @unique
  status          ApplicationStatus @default(PENDING)
  totalAmount     Decimal           @default(0) @db.Decimal(10, 2)
  paidAmount      Decimal           @default(0) @db.Decimal(10, 2)
  appointmentDate DateTime?
  appointmentSlot String?
  submittedAt     DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents       Document[]
  comments        ApplicationComment[]
  statusHistory   ApplicationStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@index([applicationNo])
  @@map("applications")
}

model Document {
  id            String   @id @default(uuid())
  applicationId String
  documentType  String
  fileName      String
  fileUrl       String
  fileSize      Int
  uploadedAt    DateTime @default(now())
  isVerified    Boolean  @default(false)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model ApplicationComment {
  id            String   @id @default(uuid())
  applicationId String
  comment       String   @db.Text
  isInternal    Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_comments")
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  oldStatus     ApplicationStatus
  newStatus     ApplicationStatus
  changedBy     String
  note          String?
  changedAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_history")
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("text")
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_content")
}

model AppointmentSlot {
  id          String   @id @default(uuid())
  date        DateTime
  slot        String
  maxCapacity Int      @default(10)
  booked      Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, slot])
  @@map("appointment_slots")
}

model Notification {
  id        String   @id @default(uuid())
  adminId   String?
  type      String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(uuid())
  adminId     String
  action      String
  entity      String
  entityId    String?
  description String   @db.Text
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model SystemStats {
  id                String   @id @default(uuid())
  date              DateTime @unique
  totalApplications Int      @default(0)
  totalUsers        Int      @default(0)
  totalRevenue      Decimal  @default(0) @db.Decimal(12, 2)
  pendingApps       Int      @default(0)
  approvedApps      Int      @default(0)
  rejectedApps      Int      @default(0)

  @@map("system_stats")
}

model AppointmentText {
  id             String   @id @default(uuid())
  countryName    String   @unique
  appointmentText String  @default("Appointment in 10 days or less")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      String?

  @@map("appointment_texts")
}

