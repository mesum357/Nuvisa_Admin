# Copy to .env.local

# VPS Postgres — use database `nuvisa_admin` for this app (see infrastructure/postgres/README.md)
DATABASE_URL="postgresql://nuvisa:PASSWORD@127.0.0.1:5432/nuvisa_admin"
DIRECT_URL="postgresql://nuvisa:PASSWORD@127.0.0.1:5432/nuvisa_admin"

NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me

BACKEND_API_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000
ADMIN_PUBLIC_URL=http://localhost:3001

SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@nuvisa.co.uk

NEXT_PUBLIC_SITE_URL=http://localhost:3002
FRONTEND_REVALIDATE_URLS=http://localhost:3002
REVALIDATE_SECRET=change-me-local-revalidate-secret
