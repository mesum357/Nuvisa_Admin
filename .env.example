# Copy to .env.local

# Local `next dev`: session pooler on 5432. Vercel/production: transaction pooler on 6543 with pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&connect_timeout=30&connection_limit=10"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&connect_timeout=30"

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me

BACKEND_API_URL=http://localhost:4000
ADMIN_PUBLIC_URL=http://localhost:3001

SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@nuvisa.co.uk

NEXT_PUBLIC_SITE_URL=http://localhost:3002
REVALIDATE_SECRET=change-me-local-revalidate-secret
